# Copy to .env to override the defaults; `make run` passes the file to the container (--env-file).
# The same variables work for a local run: export them before `make dev`.

# Default recognition language; its model is loaded at startup.
OCR_LANG=en
# Languages accepted in the `lang` form field; each model is loaded on first use.
OCR_LANGS=en,ru
# 0 = load the default model on the first request instead of at startup.
OCR_PRELOAD=1
# Larger images and PDF pages are downscaled to this size (longest side, px).
OCR_MAX_IMAGE_SIDE=2200
# Resolution used to rasterize PDF pages.
OCR_PDF_DPI=170
# Only the first N pages of a PDF are recognized.
OCR_MAX_PDF_PAGES=10
# Upload size limit, MB.
MAX_UPLOAD_MB=15
